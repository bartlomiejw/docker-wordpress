# Copy to .env (`make init` does this and fills in random secrets).
# .env is gitignored - never commit real credentials.

# --- Project ------------------------------------------------------------
# Compose project name; also prefixes container, network and image names.
COMPOSE_PROJECT_NAME=wordpress

# Site hostname. *.localhost resolves to 127.0.0.1 without /etc/hosts edits.
# Subdomains used locally: traefik.<DOMAIN>, mail.<DOMAIN>, pma.<DOMAIN>.
# Production: your real domain, e.g. example.test -> www.example.test.
DOMAIN=wp.localhost

# Interface and ports the local stack listens on (production: all, 80/443).
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443

# --- WordPress / Bedrock ------------------------------------------------
WP_ENV=development
# Defaults to https://<DOMAIN>. Set it when HTTPS_PORT is not 443,
# e.g. WP_HOME=https://wp.localhost:8443
# WP_HOME=
WP_TITLE="WordPress on Docker"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.test

# Salts - generated by `make init`.
AUTH_KEY=change-me
SECURE_AUTH_KEY=change-me
LOGGED_IN_KEY=change-me
NONCE_KEY=change-me
AUTH_SALT=change-me
SECURE_AUTH_SALT=change-me
LOGGED_IN_SALT=change-me
NONCE_SALT=change-me

# --- Database -----------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# --- Cache --------------------------------------------------------------
VARNISH_SIZE=256M
REDIS_MAXMEMORY=128mb

# --- Mail ---------------------------------------------------------------
# Local: Mailpit catches everything (https://mail.<DOMAIN>).
# Production: an unauthenticated relay reachable from the containers, or
# configure an SMTP plugin in WordPress instead.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=wordpress@example.test

# --- Traefik ------------------------------------------------------------
TRAEFIK_LOG_LEVEL=INFO
# htpasswd entry protecting the dashboard (and phpMyAdmin in production).
# Keep the single quotes: the hash contains "$". Generated by `make init`.
TRAEFIK_BASIC_AUTH_USERS='admin:$apr1$change-me'
# Plain-text dashboard password, for your reference only (not used by compose).
TRAEFIK_DASHBOARD_PASSWORD=change-me

# Production only (compose.prod.yaml).
ACME_EMAIL=admin@example.test
# Use the staging CA while testing to avoid Let's Encrypt rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
